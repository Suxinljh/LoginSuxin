{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "login-suxin",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  // 非敏感配置。密钥（BETTER_AUTH_SECRET、第三方登录）用 wrangler secret 管理。
  "vars": {
    "BETTER_AUTH_URL": "https://account.ljhsu.xin",
    "TRUSTED_ORIGINS": "https://account.ljhsu.xin",
    // 确认邮件可正常投递后再改成 "true"，否则未验证用户会卡在登录前。
    "REQUIRE_EMAIL_VERIFICATION": "true",
    "EMAIL_FROM": "Suxin Account <login@mail.ljhsu.xin>",
    // 账号中心通过 EchoMind 的支付宝商户退款接口发起原路退款。
    "ECHOMIND_REFUND_URL": "https://echomind.ljhsu.xin/api/pay/admin/refund"
  },
  // 每天 03:23 UTC（北京时间 11:23）跑一次退款申请超时失效与余额/台账对账。
  "triggers": {
    "crons": ["23 3 * * *"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountDO"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Sending：发送验证/重置邮件，不需要第三方 API Key。
  // 发件域名必须已在 Email Sending 中启用；限制发件地址避免被滥用。
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@mail.ljhsu.xin"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "login-suxin",
      "database_id": "7cb2e435-f4f1-43d7-b0f0-fd1820ee575e"
    }
  ],
  "routes": [
    {
      "pattern": "account.ljhsu.xin",
      "custom_domain": true
    },
    {
      // 旧域名保留并 308 到 account.ljhsu.xin，避免旧书签/客户端直接 404。
      "pattern": "login.ljhsu.xin",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
