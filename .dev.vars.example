# 本地开发环境变量。复制为 .dev.vars 后填写；.dev.vars 不进入 Git。
# 生成密钥：openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# 允许登录的来源，逗号分隔。
# http://login.ljhsu.xin 是 wrangler dev 对自定义域名路由重写后的本地来源，不要删。
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://login.ljhsu.xin

# 本地开发可关闭邮箱验证；生产环境建议设为 true
REQUIRE_EMAIL_VERIFICATION=false

# 第三方登录（可选，留空则不显示对应按钮）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 邮件发送（可选；留空时验证/重置链接会打印到 Worker 控制台）
EMAIL_FROM=Suxin Login <login@mail.ljhsu.xin>
