{
  "name": "login-suxin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,green \"wrangler dev --local --port ${WORKER_PORT:-8787}\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "schema:generate": "pnpm dlx auth@latest generate --config ./src/auth.cli.ts --adapter drizzle --dialect sqlite --output ./src/db/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply login-suxin --local",
    "db:migrate:remote": "wrangler d1 migrations apply login-suxin --remote",
    "create-client": "node scripts/create-client.mjs",
    "preview:email": "node scripts/preview-email.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "^4.153.0"
  }
}
